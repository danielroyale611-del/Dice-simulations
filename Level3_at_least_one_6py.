import random

def simulate_at_least_one_6(trials=100000):
    count = 0
    for _ in range(trials):
        d1 = random.randint(1,6)
        d2 = random.randint(1,6)
        if d1 == 6 or d2 == 6:
            count += 1
    prob = count / trials
    print(f"Trials: {trials}")
    print(f"At least one 6: {count}")
    print(f"Estimated: {prob:.4f}, Theoretical: {11/36:.4f}")

if __name__ == "__main__":
    simulate_at_least_one_6()
